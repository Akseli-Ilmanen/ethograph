{# wizard_nwb_codegen.j2 — ethograph alignment setup (re-runnable on new data) #}
# conda activate ethograph
import re
import natsort
import pandas as pd
from pathlib import Path
import ethograph as eto
{% if any_pose %}
from movement.io import load_poses
{% endif %}

{% if trial_table_source %}
# ─── 1. Session table (from file) ───
session_table = pd.read_csv("{{ trial_table_source }}", sep="{{ trial_table_sep }}")

{% else %}
# ─── 1. Discover media files ───
# You may need to adjust regex/patterns.
{% for mod in media_modalities %}
{% if mod.file_mode == "single" %}
{{ mod.name }}_by_trial = {"session": {"0": Path("{{ mod.single_file_path }}")}}
{% elif mod.folder_path %}
{{ mod.name }}_folder = Path("{{ mod.folder_path }}")
{% if mod.extensions | length == 1 %}
{{ mod.name }}_files = natsort.natsorted({{ mod.name }}_folder.glob("{{ '**/*' if mod.nested_subfolders else '*' }}{{ mod.extensions[0] }}"))
{% else %}
{{ mod.name }}_files = natsort.natsorted(
    f for ext in [{{ mod.extensions | map('format_glob', '') | join(', ') }}]
    for f in {{ mod.name }}_folder.glob("{{ '**/*' if mod.nested_subfolders else '*' }}" + ext)
)
{% endif %}

{% if mod.regex %}
{{ mod.name }}_pattern = re.compile(r"{{ mod.regex }}")
{{ mod.name }}_by_trial = {}
for _f in {{ mod.name }}_files:
    _m = {{ mod.name }}_pattern.search(_f.stem)
    if _m:
        _trial = int(_m["trial"]) if _m["trial"].isdigit() else _m["trial"]
{% if mod.device_role %}
        _device = _m["{{ mod.device_role }}"] if "{{ mod.device_role }}" in _m.groupdict() else "0"
{% else %}
        _device = "0"
{% endif %}
        {{ mod.name }}_by_trial.setdefault(_trial, {})[_device] = _f
{% else %}
# No trial/device pattern detected — files treated as ordered trials with device "0"
{{ mod.name }}_by_trial = {i + 1: {"0": f} for i, f in enumerate({{ mod.name }}_files)}
{% endif %}
{% endif %}
{% endfor %}

# ─── 2. Build session table ───
_all_trials = sorted(set().union(*(d.keys() for d in [{% for mod in media_modalities %}{{ mod.name }}_by_trial, {% endfor %}])))
_all_devices = sorted({dev for d in [{% for mod in media_modalities %}{{ mod.name }}_by_trial, {% endfor %}] for files in d.values() for dev in files})

session_table = pd.DataFrame({"trial": _all_trials})
{% for mod in media_modalities %}
for _dev in _all_devices:
    session_table[f"{{ mod.name }}_{_dev}"] = [
        str({{ mod.name }}_by_trial.get(_t, {}).get(_dev) or "") for _t in _all_trials
    ]
{% endfor %}
# Drop columns that are entirely empty
session_table = session_table.loc[:, (session_table != "").any()]

{% endif %}
# ─── 3. Build NWB alignment file ───
{% if output_path %}
nwb_path = Path("{{ output_path }}").parent / ".ethograph" / "alignment.nwb"
{% else %}
nwb_path = Path(".ethograph") / "alignment.nwb"
{% endif %}

eto.pair_media(
    trial_table=session_table,
    stream_rates={{ stream_rates_literal }},
    output_path=nwb_path,
{% if pose_fps %}
    pose_fps={{ pose_fps }},
{% endif %}
)

# ─── 4. Load trial datasets and save ───
# TODO: populate ds_list with per-trial xarray Datasets
{% if any_pose %}
# Example with pose data:
# ds_list = []
# for trial in session_table["trial"]:
#     pose_path = session_table.loc[session_table["trial"] == trial, "pose_0"].iloc[0]
#     ds = load_poses.from_dlc_file(pose_path, fps={{ pose_fps }})
#     ds.attrs["trial"] = trial
#     ds_list.append(ds)
{% endif %}
dt = eto.from_datasets(ds_list)
{% if output_path %}
dt.save("{{ output_path }}")
{% else %}
dt.save("output.nc")  # TODO: set output path
{% endif %}
{% if offsets %}

# Stream offsets stored in NWB ImageSeries
{% for stream, offset in offsets %}
# {{ stream }}: {{ offset }} s
{% endfor %}
{% endif %}
