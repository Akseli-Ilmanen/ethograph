{% if session_wide_entries and not session_wide %}
# One file for the whole session: (file, sample rate, when it starts relative to trial 1)
session_wide = {
{% for col, file, rate, offset in session_wide_entries %}
    "{{ col }}": ({{ file }}, {{ rate }}, {{ offset }}),
{% endfor %}
}

{% endif %}
eto.pair_media(
    table,
    stream_rates={{ stream_rates_literal }},
{% if session_wide or session_wide_entries %}
    session_wide=session_wide,
{% endif %}
    output_path=f"{session_dir}/.ethograph/alignment.nwb",
{% if individuals %}
    individuals=rig["individuals"],  # who is labelled; the session record is their one home
{% endif %}
)
